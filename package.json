{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test:frontend": "${PLAYWRIGHT_PYTHON:-python3} -m unittest discover -s tests/Frontend -v",
        "test:frontend-api": "node tests/Frontend/workshop_api.test.mjs && node tests/Frontend/workshop_attachments.test.mjs && node tests/Frontend/workshop_operations.test.mjs",
        "test:e2e-workshop": "bash tests/run-postgres.sh --e2e-workshop",
        "test:e2e-workshop-execution": "bash tests/run-postgres.sh --e2e-workshop-execution"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "6.0.10",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "5.9.3",
        "vite": "^8.0.0",
        "vue-tsc": "3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "vue": "3.5.43"
    }
}
